{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stankquilizer-telemetry",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stankquilizer-observatory",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }]
}
