{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stankquilizer-observatory",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stankquilizer-observatory",
      "database_id": "89e93a68-87c5-42fa-b939-4b569136a85b"
    }
  ],

  "secrets": {
    "required": [
      "OBSERVATORY_PASSWORD"
    ]
  }
}
